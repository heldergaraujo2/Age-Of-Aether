+      if (['-', '_', 'subtract'].includes(key) && !event.repeat) { event.preventDefault(); adjustCameraZoom(-.1); return; }
+      if (key === '0' && !event.repeat) { event.preventDefault(); setCameraZoom(1); return; }
+      if (key === 'm' && !event.repeat) { event.preventDefault(); openWorldMap(); return; }
+      if (key === 'j' && !event.repeat) { event.preventDefault(); showQuestJournal(); return; }
